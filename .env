#Env for Hugging Face
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_PROJECT="beer-finder"
USER_AGENT="Beer Finder"


# Google Cloud Configuration
GOOGLE_PROJECT_ID=gen-lang-client-0908313786

# Application Settings
LOG_LEVEL=INFO
MAX_RETRIES=3
REQUEST_DELAY=1.0
CACHE_ENABLED=true
CACHE_TTL=3600

# Rate Limiting
GOOGLE_SEARCH_RATE_LIMIT=100
GEMINI_RATE_LIMIT=60

# Output Settings
OUTPUT_DIR=./data/results
CACHE_DIR=./data/cache

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=abccjbaka.anthony@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM_NAME=Beer Finder
SESSION_SECRET_KEY=your-random-secret-key
FLASK_ENV=development  # For testing
